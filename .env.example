# Copy to .env and fill in. .env is gitignored.
# NOTE: no inline comments after a value — docker compose env_file keeps them.

# ── Postgres ──
POSTGRES_USER=trawler
POSTGRES_PASSWORD=
POSTGRES_DB=trawler
DATABASE_URL=postgres://trawler:CHANGEME@postgres:5432/trawler

# ── qBittorrent ──
PUID=1000
PGID=1000
TZ=Asia/Dhaka
# Compose-internal only; the WebUI port is never published.
QBT_URL=http://qbittorrent:8080
QBT_CATEGORY=trawler
# Must be reachable from the internet or every torrent reports "firewalled".
# Open it in BOTH the Oracle Security List and the instance's iptables.
TORRENTING_PORT=6881
DOWNLOADS_DIR=/downloads
# What copyable download commands and share links point at.
# Production: https://your-domain.duckdns.org
# Download-token lifetime. Long enough for a multi-GB transfer plus a resume;
# not revocable by design (share links are the revocable path).
DOWNLOAD_TOKEN_TTL_SECONDS=14400

# ── API ──
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost
# openssl rand -base64 48
JWT_SECRET=
REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
OWNER_EMAIL=
# Seeded once, then change it in the UI.
OWNER_PASSWORD=

# ── Storage policy (overridable from the UI via app_settings) ──

# ── Egress guard rail. Oracle free tier is 10 TB/month. ──
EGRESS_SOFT_ALERT_BYTES=8000000000000
EGRESS_HARD_STOP_BYTES=9500000000000

# ── Production only (docker-compose.prod.yml) ──

# Automatic deletion. OFF by default — the app only SUGGESTS cleanup and the
# user decides. Set true only if you want the box to manage disk unattended.
EVICTION_ENABLED=false

# ── eviction triggers ────────────────────────────────────────────────────────
# Optional cap on the torrent library. 0 = off, which is correct on a volume
# dedicated to downloads (the Oracle deployment) where the watermark suffices.
# Set it only when the filesystem is shared with unrelated data.
DOWNLOADS_BUDGET_BYTES=0
EVICTION_TTL_HOURS=48
EVICTION_HIGH_WATERMARK_PCT=80
EVICTION_LOW_WATERMARK_PCT=60

# ── WebDAV (read-only file access) ───────────────────────────────────────────
# Separate credentials from the app login: WebDAV clients speak Basic auth, and
# these are handed to file managers rather than typed into the web UI.
WEBDAV_USER=trawler
WEBDAV_PASSWORD=change-me-openssl-rand-base64-18

# ── deployment (production overlay only) ─────────────────────────────────────
# The domain pointing at this box. TLS is issued automatically over HTTP-01,
# which needs port 80 reachable and nothing else. Any provider, any registrar,
# including a free DuckDNS subdomain.
DOMAIN=trawler.example.com
ACME_EMAIL=you@example.com

# Everything the app hands out — share links, copyable download commands —
# is built from this. Must match DOMAIN in production.
PUBLIC_BASE_URL=https://trawler.example.com

# Optional. ONLY needed for the DNS-01 challenge, i.e. when port 80 cannot be
# opened or you want a wildcard certificate. Using DuckDNS does NOT by itself
# require this; a DuckDNS subdomain works fine over HTTP-01.
# DUCKDNS_TOKEN=

# Where the production overlay pulls images from. The deploy workflow sets
# IMAGE_TAG to a specific commit; `latest` is the manual-deploy fallback.
IMAGE_BASE=ghcr.io/YOUR_USERNAME/trawler
# IMAGE_TAG=latest
