{
  "name": "trawler-api",
  "version": "0.1.0",
  "description": "Trawler API \u2014 torrents, downloads, shares and storage lifecycle",
  "license": "MIT",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "build": "tsc && tsup",
    "start:dev": "node --import=tsx --watch src/index.ts",
    "start:prod": "node dist/index.js",
    "check": "biome check --write",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "start:dev:pretty": "node --import=tsx --watch src/index.ts | pino-pretty",
    "start:worker": "tsx watch --clear-screen=false src/worker.ts",
    "start:worker:prod": "node dist/worker.js",
    "job:send": "tsx src/jobs/send.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:seed:prod": "node dist/db/seed.js"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "@node-rs/argon2": "^2.1.0",
    "archiver": "^8.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.3.1",
    "drizzle-orm": "^0.45.2",
    "express": "5.2.1",
    "express-rate-limit": "8.3.1",
    "helmet": "8.1.0",
    "http-status-codes": "2.3.0",
    "jose": "^6.2.10",
    "multer": "^2.2.0",
    "nanoid": "^6.0.1",
    "pg": "^8.23.0",
    "pg-boss": "^12.27.0",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "swagger-ui-express": "5.0.1",
    "uuid": "^14.0.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@types/archiver": "^8.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/multer": "^2.2.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "@vitest/coverage-v8": "3.2.4",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "13.1.3",
    "supertest": "7.1.4",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.2",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4"
  },
  "tsup": {
    "entry": [
      "src/index.ts",
      "src/worker.ts",
      "src/db/migrate.ts",
      "src/db/seed.ts"
    ],
    "outDir": "dist",
    "format": [
      "esm",
      "cjs"
    ],
    "target": "es2020",
    "sourcemap": true,
    "clean": true,
    "dts": true,
    "splitting": false,
    "skipNodeModulesBundle": true
  },
  "packageManager": "pnpm@10.33.0"
}
