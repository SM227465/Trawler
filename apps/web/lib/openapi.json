							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"success": { "type": "boolean" },
										"message": { "type": "string" },
										"responseObject": { "nullable": true },
										"statusCode": { "type": "number" },
										"code": { "type": "string" },
										"requestId": { "type": "string" }
									},
									"required": ["success", "message", "statusCode"]
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/files/browse": {
			"get": {
				"tags": ["File"],
