{
	"openapi": "3.0.0",
	"info": { "version": "1.0.0", "title": "Trawler API" },
	"externalDocs": { "description": "View the raw OpenAPI Specification in JSON format", "url": "/swagger.json" },
	"components": {
		"schemas": {
			"File": {
				"type": "object",
				"properties": {
					"id": { "type": "string", "format": "uuid" },
					"torrentId": { "type": "string", "format": "uuid" },
					"qbtIndex": { "type": "integer" },
					"path": { "type": "string" },
					"sizeBytes": { "type": "number" },
					"progress": { "type": "number" },
					"priority": { "type": "integer" },
					"isComplete": { "type": "boolean" },
					"contentType": { "type": "string", "nullable": true }
				},
				"required": [
					"id",
					"torrentId",
					"qbtIndex",
					"path",
					"sizeBytes",
					"progress",
					"priority",
					"isComplete",
					"contentType"
				]
			},
			"DownloadLink": {
				"type": "object",
				"properties": {
					"url": { "type": "string", "example": "/dl/eyJhbGci…/Big%20Buck%20Bunny.mp4" },
					"absoluteUrl": { "type": "string", "description": "Fully qualified — what the copy buttons hand out." },
					"filename": { "type": "string" },
					"sizeBytes": { "type": "number" },
					"expiresAt": { "type": "string" },
					"aria2c": { "type": "string", "description": "Ready-to-paste 16-connection download command." }
				},
				"required": ["url", "absoluteUrl", "filename", "sizeBytes", "expiresAt", "aria2c"]
			},
			"PublicUser": {
				"type": "object",
				"properties": {
					"id": { "type": "string", "format": "uuid" },
					"email": { "type": "string", "format": "email" },
					"createdAt": { "type": "string" }
				},
				"required": ["id", "email", "createdAt"]
			},
			"Torrent": {
				"type": "object",
				"properties": {
					"id": { "type": "string", "format": "uuid" },
					"infoHash": { "type": "string" },
					"name": { "type": "string" },
					"sizeBytes": { "type": "number" },
					"status": {
						"type": "string",
						"enum": ["queued", "downloading", "paused", "completed", "errored", "evicted"]
					},
					"qbtState": { "type": "string", "nullable": true },
					"progress": { "type": "number" },
					"dlSpeedBps": { "type": "number" },
					"upSpeedBps": { "type": "number" },
					"etaSeconds": { "type": "number", "nullable": true },
					"seedsConnected": { "type": "number" },
					"seedsTotal": { "type": "number" },
					"peersConnected": { "type": "number" },
					"peersTotal": { "type": "number" },
					"ratio": { "type": "number" },
					"availability": { "type": "number" },
					"downloadedBytes": { "type": "number" },
					"uploadedBytes": { "type": "number" },
					"pinned": { "type": "boolean" },
					"addedAt": { "type": "string" },
					"completedAt": { "type": "string", "nullable": true },
					"lastAccessedAt": { "type": "string", "nullable": true },
					"wastedBytes": { "type": "number" },
					"timeActiveSeconds": { "type": "number" },
					"seedingTimeSeconds": { "type": "number" },
					"lastActivityAt": { "type": "string", "nullable": true },
					"savePath": { "type": "string", "nullable": true },
					"contentPath": { "type": "string", "nullable": true },
					"category": { "type": "string", "nullable": true },
					"isPrivate": { "type": "boolean" },
					"piecesHave": { "type": "number" },
					"piecesNum": { "type": "number" },
					"pieceSizeBytes": { "type": "number", "nullable": true },
					"comment": { "type": "string", "nullable": true },
					"createdByClient": { "type": "string", "nullable": true },
					"trackerHost": { "type": "string", "nullable": true },
					"trackersCount": { "type": "number" },
					"errorMessage": { "type": "string", "nullable": true }
				},
				"required": [
					"id",
					"infoHash",
					"name",
					"sizeBytes",
					"status",
					"qbtState",
					"progress",
					"dlSpeedBps",
					"upSpeedBps",
					"etaSeconds",
					"seedsConnected",
					"seedsTotal",
					"peersConnected",
					"peersTotal",
					"ratio",
					"availability",
					"downloadedBytes",
					"uploadedBytes",
					"pinned",
					"addedAt",
					"completedAt",
					"lastAccessedAt",
					"wastedBytes",
					"timeActiveSeconds",
					"seedingTimeSeconds",
					"lastActivityAt",
					"savePath",
					"contentPath",
					"category",
					"isPrivate",
					"piecesHave",
					"piecesNum",
					"pieceSizeBytes",
					"comment",
					"createdByClient",
					"trackerHost",
					"trackersCount",
					"errorMessage"
				]
			}
		},
		"parameters": {}
	},
